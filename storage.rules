rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 🐞 FIX: mirrors firestore.rules' hasStudioAccess() 
    function hasStudioAccess(uid) {
      let user = firestore.get(/databases/(default)/documents/users/$(uid)).data;
      return (
        user.subscriptionStatus == "active"
        && (!("subscriptionExpiresAt" in user) || request.time < user.subscriptionExpiresAt)
      )
        || (
          user.subscriptionStatus == "trial"
          && request.time < user.trialStartDate + duration.value(7, "d")
        );
    }

    // Original HD uploads — sirf owner access kar sakta hai.
    match /client-albums/{uid}/{projectId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && hasStudioAccess(uid)
                    && request.resource.size < 30 * 1024 * 1024
                    && request.resource.contentType.matches("image/.*")
                    && request.resource.size <= (
                         firestore.get(/databases/(default)/documents/users/$(uid)).data.storageLimitBytes
                         - firestore.get(/databases/(default)/documents/users/$(uid)).data.storageUsedBytes
                       );

      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Watermarked previews — public read allowed jab tak gallery active hai.
    // CHANGED: expiresAt → isActive
    match /gallery-previews/{shareId}/{fileName} {
      allow get: if firestore.get(
                      /databases/(default)/documents/publicGalleries/$(shareId)
                    ).data.isActive == true;

      allow create: if request.auth != null
                    && request.auth.uid == firestore.get(
                         /databases/(default)/documents/publicGalleries/$(shareId)
                       ).data.uid
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches("image/.*");

      allow list, update, delete: if false;
    }
  }
}
