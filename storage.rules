rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 🐞 FIX: mirrors firestore.rules' hasStudioAccess() 
    function hasStudioAccess(uid) {
      let user = firestore.get(/databases/(default)/documents/users/$(uid)).data;
      return (
        user.subscriptionStatus == "active"
        && (!("subscriptionExpiresAt" in user) || request.time < user.subscriptionExpiresAt)
      )
        || (
          user.subscriptionStatus == "trial"
          && request.time < user.trialStartDate + duration.value(7, "d")
        );
    }

    function uploadReservation(uid, fileName) {
      return firestore.get(
        /databases/(default)/documents/users/$(uid)/uploadReservations/$(fileName)
      ).data;
    }

    // Original HD uploads — sirf owner access kar sakta hai.
    // 🆕 SECURITY: contentType check tightened from "image/.*" to the exact
    // 5 types DSB.js and reservePhotoUpload allow — closes the gap where
    // "image/.*" would've also accepted image/svg+xml (SVGs can carry
    // embedded <script>) even though no camera or phone ever produces one.
    // 🐛 ROOT-CAUSE FIX: Cloud Storage Security Rules allow AT MOST 2 unique
    // Firestore documents per rule evaluation (firestore.get()/exists() calls
    // to different paths). This rule was touching 3: users/{uid} (via
    // hasStudioAccess), clientProjects/{projectId} (this exists() check), and
    // uploadReservations/{fileName} (via uploadReservation()). Exceeding the
    // 2-document limit makes Storage deny the request outright — which is
    // exactly what was happening on every single upload, regardless of how
    // correct every individual value was. Removed the clientProjects exists()
    // check: it was redundant anyway, since reservePhotoUpload (the Cloud
    // Function that creates the reservation) already verifies the project
    // exists before it ever creates one — a valid matching reservation is
    // already proof the project was real at reservation time.
    match /client-albums/{uid}/{projectId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.auth.token.email_verified == true
                    && hasStudioAccess(uid)
                    && uploadReservation(uid, fileName).uid == uid
                    && uploadReservation(uid, fileName).projectId == projectId
                    && uploadReservation(uid, fileName).fileName == fileName
                    && uploadReservation(uid, fileName).size == request.resource.size
                    && uploadReservation(uid, fileName).contentType == request.resource.contentType
                    && request.time < uploadReservation(uid, fileName).expiresAt
                    && request.resource.size < 30 * 1024 * 1024
                    && request.resource.contentType.matches("image/(jpeg|png|webp|heic|heif)");

      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Watermarked previews — public read allowed jab tak gallery active hai.
    // CHANGED: expiresAt → isActive
    match /gallery-previews/{shareId}/{fileName} {
      // Public clients receive short-lived signed URLs from getGalleryAccess
      // after PIN verification. The photographer can still review previews.
      allow get: if request.auth != null
                    && request.auth.uid == firestore.get(
                         /databases/(default)/documents/publicGalleries/$(shareId)
                       ).data.uid;

      allow create: if request.auth != null
                    && request.auth.uid == firestore.get(
                         /databases/(default)/documents/publicGalleries/$(shareId)
                       ).data.uid
                    && request.auth.token.email_verified == true
                    && hasStudioAccess(request.auth.uid)
                    && firestore.get(
                         /databases/(default)/documents/publicGalleries/$(shareId)
                       ).data.isActive == true
                    && fileName.matches("^[A-Za-z0-9_-]+\\.jpg$")
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType == "image/jpeg";

      allow list, update, delete: if false;
    }
  }
}
